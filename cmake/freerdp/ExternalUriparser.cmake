include(ExternalProject)
include(DepVersions)

set(URIPARSER_ARCHIVE_URL "https://github.com/uriparser/uriparser/releases/download/uriparser-${URIPARSER_VERSION}/uriparser-${URIPARSER_VERSION}.tar.xz")
if(DEFINED FREERDP_EXTERNAL_CACHE_DIR AND EXISTS "${FREERDP_EXTERNAL_CACHE_DIR}/uriparser-${URIPARSER_VERSION}.tar.xz")
  set(URIPARSER_ARCHIVE_URL "${FREERDP_EXTERNAL_CACHE_DIR}/uriparser-${URIPARSER_VERSION}.tar.xz")
endif()
ExternalProject_Add(
  uriparser
  DOWNLOAD_EXTRACT_TIMESTAMP OFF
  SOURCE_DIR ${CMAKE_SOURCE_DIR}/external/uriparser
  URL "${URIPARSER_ARCHIVE_URL}"
  URL_HASH ${URIPARSER_HASH}
  LIST_SEPARATOR |
  CMAKE_ARGS ${ANDROID_CMAKE_ARGS} -DURIPARSER_BUILD_DOCS:BOOL=OFF -DURIPARSER_BUILD_TESTS:BOOL=OFF
             -DURIPARSER_BUILD_TOOLS:BOOL=OFF
)
