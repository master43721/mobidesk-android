+from __future__ import annotations
+
+import unittest
+from aiohttp.test_utils import TestClient, TestServer
+
+from mobidesk_broker.app import create_app
+from mobidesk_broker.config import BrokerConfig
+from mobidesk_broker.grants import GrantStore
+from mobidesk_broker.lifecycle import FakeLifecycleProvider
+from mobidesk_broker.rate_limit import RateLimiter
+from mobidesk_broker.supabase_api import InvalidAccessToken
+
+USER_ID = "b4f6658a-c29d-4aab-9c02-3b3d5a1ff3d2"
+VM_ID = "640bfd92-7418-4266-b439-2a39169d7b2e"
+
+class FakeSupabase:
+    def __init__(self, assignments=None):
+        self.assignments = assignments if assignments is not None else [{"vm_id": VM_ID, "vm_name": "win-01"}]
+        self.calls = 0
+
+    async def resolve_user_vm(self, token: str):
+        self.calls += 1
+        if token != "valid-user-token":
+            raise InvalidAccessToken
+        return USER_ID, list(self.assignments)
+
+
+class VmStatusTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.fake_supabase = FakeSupabase()
+        self.fake_lifecycle = FakeLifecycleProvider(default_state="RUNNING")
+        self.rate_limiter = RateLimiter()
+
+        async def fake_rdp_prober(host, port, timeout_seconds):
+            return "RDP_NEGOTIATION_OK"
+
+        self.fake_prober = fake_rdp_prober
+
+        self.config = BrokerConfig(
+            supabase_url="https://unit-test.supabase.co",
+            supabase_publishable_key="not-a-real-key",
+            vm_endpoints={
+                VM_ID: "192.168.122.11",
+                "00000000-0000-4000-8000-000000000002": "192.168.122.12",
+                "00000000-0000-4000-8000-000000000003": "192.168.122.13",
+                "00000000-0000-4000-8000-000000000004": "192.168.122.14",
+            },
+            grant_ttl_seconds=60,
+            grant_cooldown_seconds=0,
+            connect_timeout_seconds=1,
+            max_sessions=4,
+        )
+
+        self.app = create_app(
+            self.config,
+            supabase_api=self.fake_supabase,
+            grant_store=GrantStore(ttl_seconds=60, cooldown_seconds=0, max_active_sessions=4),
+            lifecycle_provider=self.fake_lifecycle,
+            rate_limiter=self.rate_limiter,
+            rdp_prober=self.fake_prober,
+        )
+        self.client = TestClient(TestServer(self.app))
+        await self.client.start_server()
+
+    async def asyncTearDown(self):
+        await self.client.close()
+
+    async def test_vm_status_schema_and_no_prohibited_fields(self):
+        response = await self.client.get(
+            "/v1/vm-status",
+            headers={"Authorization": "Bearer valid-user-token"},
+        )
+        self.assertEqual(response.status, 200)
+        body = await response.json()
+
+        # Contract v1.1 schema
+        self.assertIn("lifecycle", body)
+        self.assertIn("rdpTransport", body)
+        self.assertIn("sampledAt", body)
+        self.assertIn("probeDurationMs", body)
+        self.assertIn("staleAfterSeconds", body)
+        self.assertIn("requestId", body)
+        self.assertIn("assignmentTag", body)
+
+        self.assertEqual(body["lifecycle"], "RUNNING")
+        self.assertEqual(body["rdpTransport"], "RDP_NEGOTIATION_OK")
+        self.assertEqual(body["staleAfterSeconds"], 15)
+        self.assertTrue(body["requestId"].startswith("req_"))
+        self.assertTrue(body["assignmentTag"].startswith("asg_tag_"))
+
+        # Zero prohibited fields
+        prohibited = ["vm_id", "vmid", "host", "hostname", "ip", "ipv4", "port", "password", "token", "service_role"]
+        for p in prohibited:
+            self.assertNotIn(p, body)
+
+    async def test_vm_status_stopped_lifecycle_skips_transport(self):
+        self.fake_lifecycle.default_state = "STOPPED"
+        response = await self.client.get(
+            "/v1/vm-status",
+            headers={"Authorization": "Bearer valid-user-token"},
+        )
+        self.assertEqual(response.status, 200)
+        body = await response.json()
+        self.assertEqual(body["lifecycle"], "STOPPED")
