+        """
+        Rechecks that the authenticated session and assignment remain active.
+        Returns True if valid, False if revoked.
+        Raises an exception if the upstream service is temporarily unreachable (outage).
+        """
+        raise NotImplementedError
+
+
+class FakeAssignmentRechecker(AssignmentRechecker):
+    def __init__(self, active_pairs: set[tuple[str, str]] | None = None) -> None:
+        self.active_pairs = set(active_pairs) if active_pairs else set()
+        self.simulated_outages: int = 0
+
+    def set_active(self, user_id: str, vm_id: str, active: bool = True) -> None:
+        if active:
+            self.active_pairs.add((user_id, vm_id))
+        else:
+            self.active_pairs.discard((user_id, vm_id))
+
+    def trigger_outage(self, consecutive_count: int = 1) -> None:
+        self.simulated_outages = consecutive_count
+
+    async def check_active_assignment(self, user_id: str, vm_id: str, session_id: str) -> bool:
+        if self.simulated_outages > 0:
+            self.simulated_outages -= 1
+            raise ConnectionError("Simulated Supabase identity service network outage")
+        return (user_id, vm_id) in self.active_pairs
+
+
+class BlockedSupabaseRechecker(AssignmentRechecker):
+    """
+    Real adapter is BLOCKED per governance pending Owner decision on DEC-REVOKE
+    in docs/dev-loop/OWNER_DECISIONS_ROUND2.md.
+    Service-role keys are strictly prohibited by AGENTS.md §1.3.
+    """
+    async def check_active_assignment(self, user_id: str, vm_id: str, session_id: str) -> bool:
+        raise NotImplementedError(
+            "Real Supabase rechecker adapter is BLOCKED pending Project Owner decision on DEC-REVOKE. "
+            "Service-role key usage is prohibited by AGENTS.md §1.3."
+        )
