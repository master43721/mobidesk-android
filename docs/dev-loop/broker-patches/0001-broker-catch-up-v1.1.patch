+
+    async def test_vm_status_rate_limit_30_per_minute(self):
+        for _ in range(30):
+            res = await self.client.get(
+                "/v1/vm-status",
+                headers={"Authorization": "Bearer valid-user-token"},
+            )
+            self.assertEqual(res.status, 200)
+
+        # 31st request should be rate-limited
+        blocked_res = await self.client.get(
+            "/v1/vm-status",
+            headers={"Authorization": "Bearer valid-user-token"},
+        )
+        self.assertEqual(blocked_res.status, 429)
+        self.assertIn("Retry-After", blocked_res.headers)
+        body = await blocked_res.json()
+        self.assertEqual(body["code"], "ASSIGN-02")
+        self.assertIn("retryAfterSeconds", body)
