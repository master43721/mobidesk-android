@@ -0,0 +1,49 @@
+from __future__ import annotations
+
+import datetime
+import json
+import logging
+import sys
+from typing import Any
+
+logger = logging.getLogger("mobidesk_broker.audit")
+
+class AuditLogger:
+    @staticmethod
+    def log_event(
+        event_type: str,
+        *,
+        request_id: str,
+        outcome: str,
+        reason_code: str | None = None,
+        duration_ms: int | None = None,
+        bucket: str | None = None,
+        extra: dict[str, Any] | None = None,
+    ) -> None:
+        """
+        Emits a structured JSON audit log entry with strict redaction guarantees.
+        Never logs JWTs, passwords, raw grants, student names, VM UUIDs, IPs, or hostnames.
+        """
+        payload: dict[str, Any] = {
+            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            "event": event_type,
+            "requestId": request_id,
+            "outcome": outcome,
+        }
+        if reason_code:
+            payload["reasonCode"] = reason_code
+        if duration_ms is not None:
+            payload["durationMs"] = duration_ms
+        if bucket is not None:
+            payload["bucket"] = bucket
+        if extra:
+            # Strictly filter keys in extra to prevent accidental leakage
+            safe_extra = {
+                k: v for k, v in extra.items()
+                if k in ("staleAfterSeconds", "probeDurationMs", "retryAfterSeconds", "relayCloseCode", "transport")
+            }
+            payload.update(safe_extra)
+
+        log_line = json.dumps(payload, separators=(",", ":"))
+        sys.stdout.write(log_line + "\n")
+        sys.stdout.flush()
