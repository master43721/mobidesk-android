+++ b/tests/test_rdp_probe.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+import asyncio
+import struct
+import unittest
+
+from mobidesk_broker.rdp_probe import probe_rdp_transport, X224_CR_PACKET
+
+class RdpProbeTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.server = None
+
+    async def asyncTearDown(self):
+        if self.server:
+            self.server.close()
+            await self.server.wait_closed()
+
+    async def _start_mock_server(self, response_bytes: bytes):
+        async def handle_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
+            try:
+                # Read CR packet
+                data = await reader.read(1024)
+                if data == X224_CR_PACKET:
+                    writer.write(response_bytes)
+                    await writer.drain()
+            finally:
+                writer.close()
+                await writer.wait_closed()
+
+        self.server = await asyncio.start_server(handle_client, "127.0.0.1", 0)
+        port = self.server.sockets[0].getsockname()[1]
+        return port
+
+    async def test_probe_confirms_x224_code_0xd0(self):
+        # Valid TPKT + X.224 CC TPDU (code 0xD0)
+        # TPKT len = 11 (4 header + 7 TPDU)
+        cc_tpdu = bytes([
+            0x03, 0x00, 0x00, 0x0B,  # TPKT len = 11
+            0x06,                    # LI = 6
+            0xD0,                    # CC TPDU code (0xD0)
+            0x00, 0x00,              # DST-REF
+            0x12, 0x34,              # SRC-REF
+            0x00,                    # Class 0
+        ])
+        port = await self._start_mock_server(cc_tpdu)
+        result = await probe_rdp_transport("127.0.0.1", port=port, timeout_seconds=1.0)
+        self.assertEqual(result, "RDP_NEGOTIATION_OK")
+
+    async def test_probe_accepts_extra_payload_without_matching_length(self):
+        # Even if CC TPDU has negotiation confirm data appended (e.g. 19 bytes),
+        # as long as TPKT is valid and code is 0xD0, it succeeds.
+        cc_tpdu_with_payload = bytes([
+            0x03, 0x00, 0x00, 0x13,  # TPKT len = 19
+            0x0E,                    # LI = 14
+            0xD0,                    # CC TPDU code
+            0x00, 0x00,
+            0x12, 0x34,
+            0x00,
+            0x02, 0x00, 0x08, 0x00, 0x03, 0x00, 0x00, 0x00  # RDP_NEG_RSP
+        ])
+        port = await self._start_mock_server(cc_tpdu_with_payload)
+        result = await probe_rdp_transport("127.0.0.1", port=port, timeout_seconds=1.0)
+        self.assertEqual(result, "RDP_NEGOTIATION_OK")
+
+    async def test_probe_returns_tcp_reachable_when_code_not_0xd0(self):
+        # TPDU with error or different code (e.g. 0x70)
+        error_tpdu = bytes([
+            0x03, 0x00, 0x00, 0x0B,
+            0x06,
+            0x70,  # ER TPDU (Error)
+            0x00, 0x00,
+            0x12, 0x34,
+            0x00,
+        ])
+        port = await self._start_mock_server(error_tpdu)
+        result = await probe_rdp_transport("127.0.0.1", port=port, timeout_seconds=1.0)
+        self.assertEqual(result, "TCP_REACHABLE")
+
+    async def test_probe_returns_tcp_unreachable_on_connection_refused(self):
+        # Closed port on loopback
+        result = await probe_rdp_transport("127.0.0.1", port=65530, timeout_seconds=0.5)
+        self.assertEqual(result, "TCP_UNREACHABLE")
