index 0000000..a5c6a72
--- /dev/null
+++ b/mobidesk_broker/lifecycle.py
@@ -0,0 +1,85 @@
+from __future__ import annotations
+
+import asyncio
+from typing import Any
+
+class LifecycleProvider:
+    async def get_lifecycle(self, vm_id: str, timeout_seconds: float = 1.0) -> str:
+        raise NotImplementedError
+
+
+class FakeLifecycleProvider(LifecycleProvider):
+    def __init__(self, states: dict[str, str] | None = None, default_state: str = "RUNNING") -> None:
+        self.states = dict(states) if states else {}
+        self.default_state = default_state
+
+    async def get_lifecycle(self, vm_id: str, timeout_seconds: float = 1.0) -> str:
+        state = self.states.get(vm_id, self.default_state)
+        if state == "TIMEOUT":
+            await asyncio.sleep(timeout_seconds + 0.1)
+            return "UNKNOWN"
+        if state == "ERROR_RAISE":
+            raise RuntimeError("Simulated lifecycle adapter error")
+        return state
+
+
+class LibvirtLifecycleProvider(LifecycleProvider):
+    def __init__(self, uri: str = "qemu:///system", executor: Any = None) -> None:
+        self.uri = uri
+        self.executor = executor
+
+    def _sync_get_state(self, vm_id: str) -> str:
+        try:
+            import libvirt  # type: ignore
+        except ImportError:
+            return "UNKNOWN"
+
+        try:
+            conn = libvirt.openReadOnly(self.uri)
+            if conn is None:
+                return "UNKNOWN"
+            try:
+                # Look up by UUID or name
+                dom = None
+                try:
+                    dom = conn.lookupByUUIDString(vm_id)
+                except Exception:
+                    try:
+                        dom = conn.lookupByName(vm_id)
+                    except Exception:
+                        pass
+
+                if dom is None:
+                    return "UNKNOWN"
+
+                state, _ = dom.state()
+                # Libvirt state mappings
+                # 1 = VIR_DOMAIN_RUNNING
+                # 2 = VIR_DOMAIN_BLOCKED
+                # 3 = VIR_DOMAIN_PAUSED
+                # 4 = VIR_DOMAIN_SHUTDOWN
+                # 5 = VIR_DOMAIN_SHUTOFF
+                # 6 = VIR_DOMAIN_CRASHED
+                # 7 = VIR_DOMAIN_PMSUSPENDED
+                if state == 1:
+                    return "RUNNING"
+                elif state in (2, 3, 4, 5, 7):
+                    return "STOPPED"
+                elif state == 6:
+                    return "ERROR"
+                return "UNKNOWN"
+            finally:
+                conn.close()
+        except Exception:
+            return "UNKNOWN"
+
+    async def get_lifecycle(self, vm_id: str, timeout_seconds: float = 1.0) -> str:
+        loop = asyncio.get_running_loop()
+        try:
+            return await asyncio.wait_for(
+                loop.run_in_executor(self.executor, self._sync_get_state, vm_id),
+                timeout=timeout_seconds,
+            )
+        except (asyncio.TimeoutError, Exception):
+            # Requirement: Report only observable states. Any error = UNKNOWN, never RUNNING.
+            return "UNKNOWN"
