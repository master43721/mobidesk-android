+async def ready(request: web.Request) -> web.Response:
+    config: BrokerConfig = request.app[CONFIG_KEY]
+    now_utc = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
+    
+    # Safe readiness check without exposing dependencies or hosts
+    if not config.vm_endpoints or len(config.vm_endpoints) == 0:
+        return web.json_response(
+            {"status": "not_ready", "timestamp": now_utc},
+            status=503,
+            headers={"Cache-Control": "no-store", "Pragma": "no-cache"},
+        )
+    return web.json_response(
+        {"status": "ready", "timestamp": now_utc},
+        headers={"Cache-Control": "no-store", "Pragma": "no-cache"},
+    )
+
