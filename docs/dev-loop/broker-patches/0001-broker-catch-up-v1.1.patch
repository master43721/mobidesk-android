+from __future__ import annotations
+
+import asyncio
+import io
+import json
+import sys
+import unittest
+import aiohttp
+from aiohttp import WSMsgType
+from aiohttp.test_utils import TestClient, TestServer
+
+from mobidesk_broker.app import create_app
+from mobidesk_broker.audit import AuditLogger
+from mobidesk_broker.config import BrokerConfig
+from mobidesk_broker.grants import GrantStore
+from mobidesk_broker.supabase_api import InvalidAccessToken
+
+USER_ID = "b4f6658a-c29d-4aab-9c02-3b3d5a1ff3d2"
+VM_ID = "640bfd92-7418-4266-b439-2a39169d7b2e"
+
+class FakeSupabase:
+    async def resolve_user_vm(self, token: str):
+        if token == "signed-out-token":
+            raise InvalidAccessToken
+        return USER_ID, [{"vm_id": VM_ID, "vm_name": "win-01"}]
+
+class FakeWriter:
+    def __init__(self):
+        self.closed = False
+    def write(self, data: bytes):
+        pass
+    async def drain(self):
+        pass
+    def close(self):
+        self.closed = True
+    async def wait_closed(self):
+        pass
+
+class NegativesAndAuditTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.reader = asyncio.StreamReader()
+        self.writer = FakeWriter()
+        self.fake_supabase = FakeSupabase()
+
+        self.current_time = [100.0]
+        self.config = BrokerConfig(
+            supabase_url="https://unit-test.supabase.co",
+            supabase_publishable_key="not-a-real-key",
+            vm_endpoints={VM_ID: "192.168.122.11"},
+            grant_ttl_seconds=5,
+            grant_cooldown_seconds=0,
+            connect_timeout_seconds=1,
+            max_message_bytes=1024,
+            max_sessions=4,
+        )
+
+        async def fake_connector(host, port, timeout):
+            return self.reader, self.writer
+
+        self.store = GrantStore(
+            ttl_seconds=5,
+            cooldown_seconds=0,
+            max_active_sessions=4,
+            clock=lambda: self.current_time[0],
+        )
+        self.app = create_app(
+            self.config,
+            supabase_api=self.fake_supabase,
+            grant_store=self.store,
+            tcp_connector=fake_connector,
+        )
+        self.client = TestClient(TestServer(self.app))
+        await self.client.start_server()
+
+    async def asyncTearDown(self):
+        await self.client.close()
+
+    async def test_signed_out_token_rejected(self):
+        res = await self.client.post(
+            "/v1/session-grants",
+            headers={"Authorization": "Bearer signed-out-token"},
+            json={},
+        )
+        self.assertEqual(res.status, 401)
+        body = await res.json()
+        self.assertEqual(body["code"], "AUTH-01")
+
+    async def test_expired_grant_rejected(self):
+        res = await self.client.post(
+            "/v1/session-grants",
+            headers={"Authorization": "Bearer valid-token"},
+            json={},
+        )
+        self.assertEqual(res.status, 201)
+        body = await res.json()
+        grant = body["grant"]
+
+        # Advance mock clock beyond TTL (5s)
+        self.current_time[0] += 10.0
+
+        with self.assertRaises(aiohttp.WSServerHandshakeError) as err:
+            await self.client.ws_connect(
+                "/v1/rdp",
+                headers={"Authorization": f"Bearer {grant}"},
+            )
+        self.assertEqual(err.exception.status, 401)
+
+    async def test_concurrent_grant_consume_fails_for_second(self):
+        res = await self.client.post(
+            "/v1/session-grants",
+            headers={"Authorization": "Bearer valid-token"},
+            json={},
+        )
+        grant = (await res.json())["grant"]
+
+        # Consume simultaneously
+        c1 = await self.store.consume(grant)
+        c2 = await self.store.consume(grant)
+        self.assertIsNotNone(c1)
+        self.assertIsNone(c2)
+
+    async def test_text_frame_closes_with_4408(self):
+        res = await self.client.post(
+            "/v1/session-grants",
+            headers={"Authorization": "Bearer valid-token"},
+            json={},
+        )
+        grant = (await res.json())["grant"]
+
+        ws = await self.client.ws_connect(
+            "/v1/rdp",
+            headers={"Authorization": f"Bearer {grant}"},
+        )
+        await ws.send_str("This is a prohibited text frame")
+        msg = await ws.receive(timeout=1.0)
+        self.assertEqual(msg.type, WSMsgType.CLOSE)
+        self.assertEqual(ws.close_code, 4408)
+
+    async def test_oversize_frame_closes_connection(self):
+        res = await self.client.post(
+            "/v1/session-grants",
+            headers={"Authorization": "Bearer valid-token"},
+            json={},
+        )
+        grant = (await res.json())["grant"]
+
+        ws = await self.client.ws_connect(
+            "/v1/rdp",
+            headers={"Authorization": f"Bearer {grant}"},
+        )
+        # Config max_message_bytes is 1024; send 2048 bytes
+        await ws.send_bytes(b"A" * 2048)
+        msg = await ws.receive(timeout=1.0)
+        self.assertIn(msg.type, (WSMsgType.CLOSE, WSMsgType.CLOSED, WSMsgType.ERROR))
+
+    def test_audit_log_redaction_guarantees(self):
+        captured_output = io.StringIO()
+        old_stdout = sys.stdout
+        try:
+            sys.stdout = captured_output
+            AuditLogger.log_event(
+                "GRANT_ISSUED",
+                request_id="req_test_12345",
+                outcome="SUCCESS",
+                reason_code="AUTH-01",
+                duration_ms=42,
+                extra={
+                    "staleAfterSeconds": 15,
+                    "password": "SHOULD_BE_FILTERED",
+                    "jwt": "SHOULD_BE_FILTERED",
+                    "raw_grant": "SHOULD_BE_FILTERED",
+                },
+            )
+        finally:
+            sys.stdout = old_stdout
+
+        output = captured_output.getvalue().strip()
+        data = json.loads(output)
+        self.assertEqual(data["event"], "GRANT_ISSUED")
+        self.assertEqual(data["requestId"], "req_test_12345")
+        self.assertNotIn("password", data)
+        self.assertNotIn("jwt", data)
+        self.assertNotIn("raw_grant", data)
+        self.assertEqual(data["staleAfterSeconds"], 15)
