+
+def _generate_assignment_tag(user_id: str, vm_id: str) -> str:
+    digest = hashlib.sha256(f"{user_id}:{vm_id}:mobidesk_v1".encode("utf-8")).hexdigest()
+    return f"asg_tag_{digest[:16]}"
+
+
