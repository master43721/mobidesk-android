+    "TUNNEL-01": {
+        "message": "The secure connection service could not be reached.",
+        "retryable": True,
+        "http_status": 503,
+    },
+    "RDP-CERT-01": {
+        "message": "The Cloud PC security certificate could not be verified. Connection blocked.",
+        "retryable": False,
