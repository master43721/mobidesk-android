+async def vm_status(request: web.Request) -> web.Response:
+    request_id = _generate_request_id()
+    config: BrokerConfig = request.app[CONFIG_KEY]
+    rate_limiter: RateLimiter = request.app[RATE_LIMITER_KEY]
+    client_ip = get_client_ip(request, config.trusted_proxy_header)
+
+    # 1. Unauthenticated IP rate check before token inspection
+    allowed, retry_after = rate_limiter.is_allowed(f"unauth_ip:{client_ip}", limit=60)
+    if not allowed:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="RATE_LIMITED", reason_code="RATE-01")
+        return make_prd_error_response("ASSIGN-02", request_id=request_id, status=429, retry_after_seconds=retry_after)
+
     access_token = _bearer(request.headers)
     if access_token is None:
-        return web.json_response({"error": "authentication_required"}, status=401, headers={"Cache-Control": "no-store"})
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="AUTH_REQUIRED", reason_code="AUTH-01")
+        return make_prd_error_response("AUTH-01", request_id=request_id, status=401, error_key="authentication_required")
+
+    supabase: SupabaseAPI = request.app[SUPABASE_KEY]
+    try:
+        user_id, assignments = await supabase.resolve_user_vm(access_token)
+    except InvalidAccessToken:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="INVALID_TOKEN", reason_code="AUTH-01")
+        return make_prd_error_response("AUTH-01", request_id=request_id, status=401, error_key="invalid_or_expired_session")
+    except SupabaseUnavailable:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="UPSTREAM_UNAVAILABLE", reason_code="ASSIGN-02")
+        return make_prd_error_response("ASSIGN-02", request_id=request_id, status=503, error_key="identity_service_unavailable")
+
+    # 2. Per-user status rate limit (30 requests per minute)
+    allowed, retry_after = rate_limiter.is_allowed(f"user_status:{user_id}", limit=30)
+    if not allowed:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="USER_RATE_LIMITED", reason_code="ASSIGN-02")
+        return make_prd_error_response("ASSIGN-02", request_id=request_id, status=429, retry_after_seconds=retry_after)
+
+    if len(assignments) == 0:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="NO_ASSIGNMENT", reason_code="ASSIGN-01")
+        return make_prd_error_response("ASSIGN-01", request_id=request_id, status=403, error_key="no_vm_assigned")
+    if len(assignments) != 1:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="ASSIGNMENT_CONFLICT", reason_code="ASSIGN-03")
+        return make_prd_error_response("ASSIGN-03", request_id=request_id, status=409, error_key="assignment_conflict")
 
+    assignment = assignments[0]
+    vm_id = assignment["vm_id"]
+    endpoint = config.vm_endpoints.get(vm_id)
+    if endpoint is None:
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="VM_NOT_IN_ALLOWLIST", reason_code="VM-03")
+        return make_prd_error_response("VM-03", request_id=request_id, status=503, error_key="vm_not_available")
+
+    probe_start = time.monotonic()
+    lifecycle_provider: LifecycleProvider = request.app[LIFECYCLE_PROVIDER_KEY]
+    prober = request.app[RDP_PROBER_KEY]
+
+    # Staged bounded probing within 1,500 ms total probe budget
+    # Stage A: Lifecycle probe (bounded to 500 ms)
+    try:
+        lifecycle = await lifecycle_provider.get_lifecycle(vm_id, timeout_seconds=0.5)
+        if lifecycle not in ("STOPPED", "STARTING", "RUNNING", "STOPPING", "ERROR", "UNKNOWN"):
+            lifecycle = "UNKNOWN"
+    except Exception:
+        lifecycle = "UNKNOWN"
+
+    # Stage B: RDP Transport probe (bounded to 700 ms)
+    if lifecycle == "STOPPED":
+        rdp_transport = "NOT_CHECKED"
+    else:
+        try:
+            rdp_transport = await prober(endpoint, 3389, timeout_seconds=0.7)
+            if rdp_transport not in ("NOT_CHECKED", "TCP_UNREACHABLE", "TCP_REACHABLE", "RDP_NEGOTIATION_OK", "UNKNOWN"):
+                rdp_transport = "UNKNOWN"
+        except Exception:
+            rdp_transport = "UNKNOWN"
+
+    duration_ms = min(1500, max(1, int((time.monotonic() - probe_start) * 1000)))
+    assignment_tag = _generate_assignment_tag(user_id, vm_id)
+    now_utc = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
+
+    response_payload = {
+        "lifecycle": lifecycle,
+        "rdpTransport": rdp_transport,
+        "sampledAt": now_utc,
+        "probeDurationMs": duration_ms,
+        "staleAfterSeconds": 15,
+        "requestId": request_id,
+        "assignmentTag": assignment_tag,
+    }
+
+    AuditLogger.log_event(
+        "STATUS_PROBED",
+        request_id=request_id,
+        outcome="SUCCESS",
+        duration_ms=duration_ms,
+        extra={"staleAfterSeconds": 15, "probeDurationMs": duration_ms, "transport": rdp_transport},
+    )
+
+    return web.json_response(
+        response_payload,
+        status=200,
+        headers={"Cache-Control": "no-store", "Pragma": "no-cache"},
+    )
+
