new file mode 100644
index 0000000..96500db
--- /dev/null
+++ b/mobidesk_broker/rate_limit.py
@@ -0,0 +1,59 @@
+from __future__ import annotations
+
+import collections
+import ipaddress
+import time
+from typing import Any
+from aiohttp import web
+
+class RateLimiter:
+    def __init__(self) -> None:
+        # key -> deque of monotonic timestamps
+        self._events: dict[str, collections.deque[float]] = collections.defaultdict(collections.deque)
+
+    def is_allowed(self, key: str, limit: int, window_seconds: float = 60.0) -> tuple[bool, int]:
+        now = time.monotonic()
+        dq = self._events[key]
+
+        # Purge timestamps outside the window
+        cutoff = now - window_seconds
+        while dq and dq[0] <= cutoff:
+            dq.popleft()
+
+        if len(dq) >= limit:
+            oldest = dq[0]
+            retry_after = max(1, int((oldest + window_seconds) - now + 0.999))
+            return False, retry_after
+
+        dq.append(now)
+        return True, 0
+
+    def purge_idle(self, window_seconds: float = 60.0) -> None:
+        now = time.monotonic()
+        cutoff = now - window_seconds
+        stale_keys = [k for k, dq in self._events.items() if not dq or dq[-1] <= cutoff]
+        for k in stale_keys:
+            del self._events[k]
+
+
+def get_client_ip(request: web.Request, trusted_proxy_header: str | None = None) -> str:
+    """
+    Extracts client IP address securely.
+    If trusted_proxy_header is configured, extracts the rightmost IP appended by
+    the trusted reverse proxy (NEVER the leftmost untrusted header).
+    Otherwise defaults to the direct socket peer (request.remote).
+    """
+    if trusted_proxy_header and trusted_proxy_header in request.headers:
+        raw_val = request.headers[trusted_proxy_header].strip()
+        if raw_val:
+            # Rightmost entry is the proxy hop nearest to the broker
+            candidate = raw_val.split(",")[-1].strip()
+            try:
+                ipaddress.ip_address(candidate)
+                return candidate
+            except ValueError:
+                pass
+
+    if request.remote:
+        return request.remote.strip()
+    return "127.0.0.1"
diff --git a/mobidesk_broker/rdp_probe.py b/mobidesk_broker/rdp_probe.py
new file mode 100644
index 0000000..233629b
--- /dev/null
+++ b/mobidesk_broker/rdp_probe.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import struct
+from typing import Any
+
+# Valid X.224 Connection Request packet with 8-byte RDP_NEG_REQ (total 19 bytes)
+# TPKT: 03 00 00 13 (v3, res 0, len 19)
+# X.224: 0e e0 00 00 12 34 00 (LI 14, CR TPDU 0xE0, dst-ref 0, src-ref 0x1234, class 0)
+# RDP_NEG_REQ: 01 00 08 00 03 00 00 00 (type 1, flags 0, len 8, proto SSL|HYBRID)
+X224_CR_PACKET = bytes([
+    0x03, 0x00, 0x00, 0x13,
+    0x0E, 0xE0, 0x00, 0x00, 0x12, 0x34, 0x00,
+    0x01, 0x00, 0x08, 0x00, 0x03, 0x00, 0x00, 0x00
+])
+
+async def probe_rdp_transport(
+    host: str,
+    port: int = 3389,
+    timeout_seconds: float = 1.0,
+) -> str:
+    """
+    Performs a bounded RDP probe:
+    1. TCP connection to port 3389 (determines TCP_REACHABLE).
+    2. Sends a valid X.224 Connection Request with 8-byte RDP_NEG_REQ.
+    3. Parses the TPKT response and checks for X.224 code 0xD0 (Connection Confirm).
+    Never matches response by packet length.
+    Returns: 'RDP_NEGOTIATION_OK' | 'TCP_REACHABLE' | 'TCP_UNREACHABLE' | 'UNKNOWN'
+    """
+    reader: asyncio.StreamReader | None = None
+    writer: asyncio.StreamWriter | None = None
+    try:
+        try:
+            reader, writer = await asyncio.wait_for(
+                asyncio.open_connection(host=host, port=port),
+                timeout=timeout_seconds,
+            )
+        except (ConnectionRefusedError, OSError):
+            return "TCP_UNREACHABLE"
+        except asyncio.TimeoutError:
+            return "UNKNOWN"
+
+        # Connected on TCP 3389 -> at least TCP_REACHABLE
+        try:
+            writer.write(X224_CR_PACKET)
+            await asyncio.wait_for(writer.drain(), timeout=timeout_seconds)
+
+            # Read TPKT header (4 bytes)
+            tpkt_hdr = await asyncio.wait_for(reader.readexactly(4), timeout=timeout_seconds)
+            if tpkt_hdr[0] != 0x03 or tpkt_hdr[1] != 0x00:
+                return "TCP_REACHABLE"
+
+            tpkt_len = struct.unpack(">H", tpkt_hdr[2:4])[0]
+            if tpkt_len < 6 or tpkt_len > 1024:
+                return "TCP_REACHABLE"
+
+            # Read remaining TPDU bytes
+            tpdu_bytes = await asyncio.wait_for(reader.readexactly(tpkt_len - 4), timeout=timeout_seconds)
+            if len(tpdu_bytes) < 2:
+                return "TCP_REACHABLE"
+
+            # Byte 4 was LI (tpdu_bytes[0]), Byte 5 was TPDU code (tpdu_bytes[1])
+            tpdu_code = tpdu_bytes[1]
+
+            # X.224 Connection Confirm (CC TPDU) code is 0xD0 (or high nibble 0xD)
+            if (tpdu_code & 0xF0) == 0xD0:
+                return "RDP_NEGOTIATION_OK"
+
+            return "TCP_REACHABLE"
+        except (asyncio.TimeoutError, OSError):
+            return "TCP_REACHABLE"
+    finally:
+        if writer is not None:
+            writer.close()
+            with contextlib.suppress(Exception):
+                await asyncio.wait_for(writer.wait_closed(), timeout=0.2)
