     if len(assignments) != 1:
-        return web.json_response({"error": "assignment_conflict"}, status=409, headers={"Cache-Control": "no-store"})
+        AuditLogger.log_event("DENIED", request_id=request_id, outcome="ASSIGNMENT_CONFLICT", reason_code="ASSIGN-03")
+        return make_prd_error_response("ASSIGN-03", request_id=request_id, status=409, error_key="assignment_conflict")
 
     assignment = assignments[0]
     vm_id = assignment["vm_id"]
