+from __future__ import annotations
+
+import unittest
+from aiohttp.test_utils import make_mocked_request
+
+from mobidesk_broker.rate_limit import RateLimiter, get_client_ip
+
+class RateLimitUnitTests(unittest.TestCase):
+    def test_sliding_window_rate_limiter(self):
+        limiter = RateLimiter()
+        # Allow up to 5 requests
+        for _ in range(5):
+            allowed, _ = limiter.is_allowed("test_key", limit=5, window_seconds=60)
+            self.assertTrue(allowed)
+
+        # 6th request must be rejected
+        allowed, retry_after = limiter.is_allowed("test_key", limit=5, window_seconds=60)
+        self.assertFalse(allowed)
+        self.assertGreater(retry_after, 0)
+
+    def test_trusted_proxy_header_extracts_rightmost_ip(self):
+        # Client sends forged X-Forwarded-For: attacker_ip, proxy1, real_client_ip
+        req = make_mocked_request(
+            "GET",
+            "/v1/vm-status",
+            headers={"X-Forwarded-For": "198.51.100.1, 203.0.113.195, 10.0.0.5"},
+        )
+        # Without trusted proxy header configured, uses socket peer
+        peer_ip = get_client_ip(req, trusted_proxy_header=None)
+        self.assertEqual(peer_ip, "127.0.0.1")
+
+        # With trusted proxy header configured, extracts the rightmost IP
+        client_ip = get_client_ip(req, trusted_proxy_header="X-Forwarded-For")
+        self.assertEqual(client_ip, "10.0.0.5")
+
+    def test_trusted_proxy_header_invalid_ip_falls_back(self):
+        req = make_mocked_request(
+            "GET",
+            "/v1/vm-status",
+            headers={"CF-Connecting-IP": "invalid_ip_string"},
+        )
+        ip = get_client_ip(req, trusted_proxy_header="CF-Connecting-IP")
+        self.assertEqual(ip, "127.0.0.1")
