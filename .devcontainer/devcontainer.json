{
  "name": "MobiDesk Android (Java 21 + Android SDK 37)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64",
    "GRADLE_USER_HOME": "/workspaces/.cache/gradle",
    "ANDROID_USER_HOME": "/workspaces/.cache/android",
    "CCACHE_DIR": "/workspaces/.cache/ccache",
    "CCACHE_MAXSIZE": "5G",
    "CMAKE_BUILD_PARALLEL_LEVEL": "3"
  },
  "remoteEnv": {
    "PATH": "/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${containerEnv:PATH}"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "master43721/session-broker": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "ms-vscode.cpptools",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true
      }
    }
  },
  "onCreateCommand": "bash .devcontainer/update-content.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "stopContainer"
}
